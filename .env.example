# ==========================================
# RAG PIPELINE CONFIGURATION TEMPLATE (.env)
# Copy this file to .env and customize as needed
# ==========================================

# Vector DB storage directories
CHROMA_PERSIST_DIR=./vector_db/chroma_store
FAISS_INDEX_PATH=./vector_db/faiss_store

# Default collection name
COLLECTION_NAME=rag_documents

# ==========================================
# LLM GENERATION CONFIGURATION
# ==========================================
# Options: "ollama" (free, local) or "openai" (cloud, requires API key)
LLM_PROVIDER=ollama
LLM_MODEL_NAME=llama3
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Embeddings: "sentence-transformers" (free, local) or "openai"
EMBEDDING_PROVIDER=sentence-transformers

# (Optional) Only needed if EMBEDDING_PROVIDER="openai" or LLM_PROVIDER="openai"
OPENAI_API_KEY=your_openai_api_key_here

